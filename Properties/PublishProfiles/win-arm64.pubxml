<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
        <PublishDir>bin/publish/win-arm64/</PublishDir>
        <!-- Bundle the .NET runtime so users don't need to install it -->
        <SelfContained>true</SelfContained>
        <!-- One executable instead of dozens of DLLs -->
        <PublishSingleFile>true</PublishSingleFile>
        <!-- Pack native libs (Skia, HarfBuzz) into the executable too -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <!-- Strip unused parts of the runtime and libraries (roughly halves the size) -->
        <PublishTrimmed>true</PublishTrimmed>
        <!-- Only ship English resource files for libraries -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- Use culture-neutral formatting and skip culture data -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <DebugType>none</DebugType>
    </PropertyGroup>
</Project>
